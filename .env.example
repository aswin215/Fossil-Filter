# Copy to .env (gitignored) and fill in. USE_MOCKS=true runs everything with no keys.
USE_MOCKS=true

NACE_API_KEY=<<PASTE_NACE_API_KEY_HERE>>          # Intern reads this name for System 1
NACE_BASE_URL=https://console.nace.ai/v1           # endpoint is POST {base}/systemone
DREX_MODEL=drex-latest                             # alt: drex-max-v1.1; check `intern models`
DEEPINFRA_API_KEY=<<PASTE_DEEPINFRA_API_KEY_HERE>>    # System 2 for the Intern agent (partner tool)
OPENROUTER_API_KEY=<<OPTIONAL_PASTE_OPENROUTER_KEY>>  # only if using decisions:nace-ai/drex-max
NDI_API_KEY=<<PASTE_NDI_API_KEY_HERE>>             # defaults to NACE_API_KEY (same nace_sk_ key per the docs)
NDI_BASE_URL=<<PASTE_NDI_BASE_URL_HERE>>           # defaults to https://console.nace.ai (per the docs)
ANTHROPIC_API_KEY=<<PASTE_ANTHROPIC_API_KEY_HERE>>
CLAUDE_MODEL=<<PASTE_CLAUDE_MODEL_ID_HERE>>        # e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
SENSITIVE_THRESHOLD=0.20
ESCALATE_THRESHOLD=0.70

# Optional overrides
# DEEPINFRA_MODEL=Qwen/Qwen3.8-27B
# INTERN_SYSTEM2=deepinfra/Qwen/Qwen3.8-27B
# INTERN_MAX_TURNS=60
# INTERN_USE_MCP=false                             # Level C: agent uses our MCP tools (score_email = Drex)
# DREX_PRICE_PER_MTOK_INPUT=<<from the Nace pricing page>>
# DEEPINFRA_PRICE_IN=<<per 1M input tokens>>
# DEEPINFRA_PRICE_OUT=<<per 1M output tokens>>
