USE_MOCKS=true

# Nace (Drex + NDI share one key per the docs: "Authorization: Bearer nace_sk_...")
NACE_API_KEY=<<PASTE_NACE_API_KEY_HERE>>
NACE_BASE_URL=https://console.nace.ai           # verified in docs; endpoint is POST /v1/systemone
DREX_MODEL=drex-max-v1.1                        # docs: "drex-max" is retired and forwards to drex-max-v1.1; alt: drex-v2.0

# NDI uses the same Nace key and base URL by default; override only if Nace gives you separate ones
NDI_API_KEY=<<PASTE_NDI_API_KEY_HERE>>
NDI_BASE_URL=https://console.nace.ai

ANTHROPIC_API_KEY=<<PASTE_ANTHROPIC_API_KEY_HERE>>
CLAUDE_MODEL=<<PASTE_CLAUDE_MODEL_ID_HERE>>     # e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5

SENSITIVE_THRESHOLD=0.20
ESCALATE_THRESHOLD=0.70
